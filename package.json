{
  "name": "agentic-rag-assistant",
  "private": true,
  "version": "1.0.0",
  "description": "An evidence-grounded interview preparation and review agent with dynamic follow-ups and user-scoped RAG.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api,mcp -c blue,green,magenta \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:mcp\"",
    "dev:web": "vite",
    "dev:api": "npm --prefix backend run dev",
    "dev:mcp": "npm --prefix backend run mcp",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build && npm --prefix backend run check && npm --prefix backend test",
    "eval:tools": "npm --prefix backend run eval:tools",
    "eval:tools:dry": "npm --prefix backend run eval:tools:dry",
    "eval:interview": "npm --prefix backend run eval:interview",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "dompurify": "^3.4.12",
    "element-plus": "^2.12.0",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.5",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^9.2.1",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.2.4"
  }
}
