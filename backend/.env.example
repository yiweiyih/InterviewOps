# Backend server
PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173
# Optional persistent runtime directory. Docker Compose sets this to /data.
# DATA_DIR=/absolute/path/to/runtime-data

# Model provider
DEEPSEEK_API_KEY=your-api-key
